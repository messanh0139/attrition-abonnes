# Copier en env.ps1, renseigner les valeurs, puis charger avec :  . .\env.ps1
# env.ps1 contient des secrets : ne jamais le transmettre ni le versionner.
$env:PG_DSN        = "host=127.0.0.1 port=5433 dbname=attrition user=r_etl"
$env:PGPASSWORD    = "a-definir"
$env:S3_ENDPOINT   = "http://127.0.0.1:9000"
$env:S3_ACCESS_KEY = "a-definir"
$env:S3_SECRET_KEY = "a-definir"
$env:S3_BUCKET     = "bronze"
$env:PYTHONUTF8    = "1"
