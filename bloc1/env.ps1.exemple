# Copier ce fichier en env.ps1, renseigner les valeurs, puis le charger avec :  . .\env.ps1
# env.ps1 contient des secrets : il ne doit jamais être transmis ni versionné.
# Les connexions à PostgreSQL et à MinIO sont chiffrées (TLS) : leurs adresses sont définies dans config.py.
$env:PGPASSWORD          = "a-definir"      # mot de passe du rôle r_etl
$env:PGPASSWORD_ANALYSTE = "a-definir"      # mot de passe du rôle r_analyste (export vers le Bloc 5)
$env:S3_ACCESS_KEY       = "a-definir"      # identifiant MinIO (secrets\minio_user.txt)
$env:S3_SECRET_KEY       = "a-definir"      # mot de passe MinIO (secrets\minio_password.txt)
$env:S3_BUCKET           = "bronze"
$env:PYTHONUTF8          = "1"
